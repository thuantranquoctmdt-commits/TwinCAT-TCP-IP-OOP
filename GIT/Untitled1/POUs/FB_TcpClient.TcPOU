      <LineId Id="13" Count="1" />
      <LineId Id="8" Count="0" />
    </LineIds>
    <LineIds Name="FB_TcpClient.M_Disconnect">
      <LineId Id="6" Count="0" />
      <LineId Id="4" Count="0" />
    </LineIds>
    <LineIds Name="FB_TcpClient.M_Execute">
      <LineId Id="7" Count="19" />
      <LineId Id="28" Count="4" />
      <LineId Id="34" Count="13" />
      <LineId Id="49" Count="18" />
      <LineId Id="5" Count="0" />
    </LineIds>
    <LineIds Name="FB_TcpClient.M_Send">
      <LineId Id="10" Count="1" />
      <LineId Id="20" Count="0" />
      <LineId Id="8" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>